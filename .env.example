# ==============================================================================
# MESL Vault Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
# Leave empty for local development (defaults to Vite's dev proxy at http://127.0.0.1:8000).
# For production (e.g. deployed on Netlify), set this to your hosted backend URL:
# Examples:
#   VITE_API_URL=https://mesl-finance-backend.up.railway.app
#   VITE_API_URL=https://mesl-backend.onrender.com
# Note: Trailing slashes are automatically stripped.
VITE_API_URL=

